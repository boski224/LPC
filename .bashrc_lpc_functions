# ──────────────────────────────────────────
# SSH agent recovery
# ──────────────────────────────────────────
ssh_fix() {
    echo "==> Current SSH_AUTH_SOCK: ${SSH_AUTH_SOCK:-<not set>}"
    echo "==> Current keys loaded:"
    ssh-add -l 2>/dev/null || echo "    (none or agent not reachable)"

    echo ""
    echo "==> Searching for available SSH agent sockets in /tmp..."
    local sockets=()
    while IFS= read -r s; do
        sockets+=("$s")
    done < <(find /tmp/ssh-* -name "agent.*" 2>/dev/null | sort)

    if [[ ${#sockets[@]} -eq 0 ]]; then
        echo "    No SSH agent sockets found. Start one with: eval \$(ssh-agent)"
        return 1
    fi

    echo "    Found ${#sockets[@]} socket(s):"
    local best_sock=""
    local best_count=-1
    for s in "${sockets[@]}"; do
        local count
        count=$(SSH_AUTH_SOCK="$s" ssh-add -l 2>/dev/null | grep -c "^[0-9]" || true)
        echo "      $s  (keys loaded: $count)"
        if (( count > best_count )); then
            best_count=$count
            best_sock="$s"
        fi
    done

    echo ""
    if [[ -n "$best_sock" ]]; then
        export SSH_AUTH_SOCK="$best_sock"
        echo "==> SSH_AUTH_SOCK set to: $SSH_AUTH_SOCK"
        echo "==> Keys now available:"
        ssh-add -l
    else
        echo "==> Could not find a working SSH agent socket."
        return 1
    fi
}

# ──────────────────────────────────────────
# Directory stack (last 5 visited)
# ──────────────────────────────────────────
DIR_STACK=()
MAX_DIR_STACK=5

cd() {
    builtin cd "$@" || return
    # Remove duplicate if already in stack
    local new_dir="$PWD"
    DIR_STACK=("${DIR_STACK[@]/$new_dir}")
    # Remove empty entries
    local cleaned=()
    for d in "${DIR_STACK[@]}"; do
        [[ -n "$d" ]] && cleaned+=("$d")
    done
    DIR_STACK=("${cleaned[@]}")
    # Prepend new directory
    DIR_STACK=("$new_dir" "${DIR_STACK[@]}")
    # Trim to max size
    DIR_STACK=("${DIR_STACK[@]:0:$MAX_DIR_STACK}")
}

# Show last 5 visited directories
dirs_history() {
    echo "Recent directories:"
    for i in "${!DIR_STACK[@]}"; do
        echo "  [$i] ${DIR_STACK[$i]}"
    done
}

# Jump to a directory from the stack by index
cdd() {
    local index="${1:-0}"
    if [[ -n "${DIR_STACK[$index]}" ]]; then
        builtin cd "${DIR_STACK[$index]}" || return
    else
        echo "No directory at index $index"
    fi
}


# # ===================== GIT PROMPT ======================================= #
# Git branch switcher. 
function gsw() {
    git rev-parse --git-dir > /dev/null 2>&1 || { echo "Not in a git repository"; return 0; }
    
    number=1
    #git branch | while read line ; do echo $number $line ; $number=$((number+1)) ;  done
    mapfile -t branches < <(git branch --format='%(refname:short)')

    printf 'Choose a branch:\n\n'
    for i in "${!branches[@]}"; do
        printf '%d) %s\n' "$((i + 1))" "${branches[i]}"
    done
    printf 'q) Quit\n'

	echo
	read -rp "Selected branch: " choice

    case "$choice" in
        ''|*[!0-9q]*)
        echo "Invalid number"
        ;;

    q)
        echo "Quit"
        return
        ;;

    *)
        index=$((choice - 1))
        if (( index >= 0 && index < ${#branches[@]} )); then
            branch="${branches[index]}"
            #echo "You chose: $branch"
			echo
            git switch "$branch"
        else
            echo "Number out of range"
        fi
        ;;
    esac
}



# # ===================== GIT PROMPT ======================================= #
# Git branch name and state: red=uncommitted, blue=ahead <- made by me msyrek
function git_prompt(){
     unset GPROMPT
     git status > /dev/null 2>&1 && {
         local gbranch

         GPROMPT="${c_lgreen}("
         [[ -n $(git diff 2> /dev/null) ]] && GPROMPT="${GPROMPT}${c_red}*"
         [[ -n $(git status 2> /dev/null | grep ahead) ]] && GPROMPT="${GPROMPT}${c_blue}*"
         gbranch=$(git branch 2> /dev/null | grep '*' )
         #gbranch=$(git branch 2> /dev/null | grep '*' | cut -d'-' -f1,2 )
         # gbranch=$(git branch 2> /dev/null | grep '*' | awk -F'-' '{print($1$2)}'
         GPROMPT="${GPROMPT}${c_green}${gbranch}${c_lgreen})"
         echo -n "${GPROMPT}\n"
     }
}

function set_prompt () {
         export PS1="${c_green}(${PYENV_VERSION})$(git_prompt)"${c_red}'['${c_green}'\u'${c_red}'@'${c_purple}'\H'${c_red}']['${c_white}'\w'${c_red}']'${c_lyellow}'\$'${c_nc}' '
}

if command -v starship &> /dev/null; then
    eval "$(starship init bash)"
else
    PROMPT_COMMAND="set_prompt" # Fallback to default prompt or custom prompt setup
fi

# OEA functions: 

# Activating / deactivating Python environments with pyenv.
function pyactiv() {
    if [[ "$1" == "-d" ]]; then
        echo "Deactivating Python environment."
        pyenv deactivate
    elif [[ "$1" == "-l" ]]; then
        echo "Available Python environments:"
        pyenv versions --bare
    elif [[ "$1" == "-c" ]]; then
        echo "Current Python environment: ${PYENV_VERSION:-<none>}"
    elif [[ "$1" == "-p" ]]; then
        echo "Available Python versions:"
        pyenv install --list | grep -E '^\s*[0-9]+\.[0-9]+\.[0-9]+$' | sed 's/^\s*//'
    elif [[ "$1" == "-s" && -z "$2" ]]; then
        echo "Activating OEA environment: 'sage_core_3_10_13'."
        env="sage_core_3_10_13"
        pyenv activate "$env"
    elif [[ -z "$1" || "$1" == "-h" ]]; then
        echo "Usage: pyactiv [option|env]"
        echo "Options:"
        echo "  -d          Deactivate current Python environment"
        echo "  -l          List available Python environments"
        echo "  -c          Show current Python environment"
        echo "  -p          List available Python versions"
        echo "  -s          Activate OEA environment 'sage_core_3_10_13'"
        echo "  [env]       Activate specified Python environment"
    elif [[ -n "$1" ]]; then
        pyenv activate "$1"
    else 
        pyactiv -h
        pyactiv -s
    fi
}

# LOG_LEVEL switcher for OEA logs.
# Log_LEVEL possibilities: DEBUG, INFO, WARNING, ERROR, CRITICAL
function loglevel() {
    if [[ "$1" == "-h" || -z "$1" ]]; then
        echo
		echo "Currently set loglevel: $LOG_LEVEL"
        echo
        echo "Usage: loglevel [level]"
        echo "Levels: DEBUG, INFO, WARNING, ERROR, CRITICAL"
        echo "Options:"
        echo "  -c          Show current LOG_LEVEL"
        echo "  -d          Unset LOG_LEVEL (default)"  
    elif [[ "$1" =~ ^(DEBUG|INFO|WARNING|ERROR|CRITICAL|debug|info|warning|error|critical)$ ]]; then
        export LOG_LEVEL="${1^^}"           #^^} converts to uppercase
        echo "LOG_LEVEL set to: $LOG_LEVEL" 
    elif [[ "$1" == "-c" ]]; then
        echo "Current LOG_LEVEL: ${LOG_LEVEL:-<not set>}"
    elif [[ "$1" == "-d" ]]; then
        echo "Unsetting LOG_LEVEL."
        unset LOG_LEVEL
    else
        echo "Invalid log level: $1"
        echo "Use: DEBUG, INFO, WARNING, ERROR, CRITICAL"
    fi
}

function gpush() {
    echo -e "Did merged main, bumped the version and run \`uv lock\`?\n"
    echo -e "[Y] Yes  -  Proceed with push"
    echo -e "[N] No   -  Cancel push"
    echo -e "[S] Skip -  Ignore the [ merge/bump/uv lock ] and proceed with push\n"
    read -r response
    case "$response" in
        [Yy]* ) echo "Proceeding with git push." ; git push ; return 0 ;;
        [Nn]* ) echo "Please bump the version before pushing."; return 1 ;;
        [Ss]* ) echo "Skipping the version bump."; git push ; return 0 ;;
        * ) echo "Invalid response. Aborting."; return 1 ;;
    esac
}

# Sage version bumper
# Bumps the Sage version in the current environment.
function bump (){
    # 1. Verify whether the branch is merged to the origin main branch before bumping the version.
    current_branch=$(git rev-parse --abbrev-ref HEAD)
    if [[ "$current_branch" != "main" ]] && ! git merge-base --is-ancestor "$current_branch" origin/main; then
        echo "Branch $current_branch is not merged into origin/main. Aborting version bump."
        return 1
    elif [[ "$current_branch" == "main" ]]; then
        echo "Do not bump the version directly on the main branch. Please git fetch/pull instead. Aborting version bump."
        return 1
    fi
    # If no arguments simply read the pyproject.toml for the current Sage version and bump the last component of the version number.
    if [[ -z "$1" ]]; then
        current_version=$(grep -Po '(?<=^version = ")[^"]*' pyproject.toml)
        IFS='.' read -r -a version_parts <<< "$current_version"
        ((version_parts[2]++))
        new_version="${version_parts[0]}.${version_parts[1]}.${version_parts[2]}"
        #$ sed -i "s/^version = \".*\"/version = \"$new_version\"/" pyproject.toml
        #$ uv lock
        echo "Bumped Sage version to: $new_version"
    fi
}
