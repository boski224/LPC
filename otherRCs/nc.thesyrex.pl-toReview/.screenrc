############################### From WORK:
##################     standart    ###################

# standardowe opcje
startup_message     off
vbell             off
defscrollback         4096
# shell            -$SHELL
shelltitle        bash
autodetach        on

# enable: SHIFT + PGUP / SHIFT + PGDN scroll
# przewijanie zawartosci
termcapinfo rxvt ti@:te@

# change window with ALT + Q /ALT +W
# wygodniejsze przelaczanie okien
# To catch it use 'showkey -a'
# bindkey "^[[1;5D" prev
# bindkey "^[[1;5C" next
 bindkey "^[[1;6D" prev
 bindkey "^[[1;6C" next

# Autostart okienek i programów z nimi polaczonymi  

screen -t MC	 	0 mc
screen -t WORK-01       1    
screen -t WORK-02       2    
screen -t WORK-03       3    
screen -t WORK-04       4    
screen -t WORK-05       5    
screen -t WORK-06       6    
screen -t WORK-07       7    
screen -t WORK-08       8    
screen -t hTop		9 htop
select        1


###################     status bar    ###################
# status z data/load/hostname/windows
 hardstatus alwayslastline '%{= M} %H%{= G} %l %= %{= w}%-w[%{+b r}%n*%t%{-b r}%{w}]%+w %= %{c}%d %D %{B}%c '
# hardstatus string '%{= kG}[ %{G}%H %{g}][%= %{= kw}%?%-Lw%?%{r}(%{W}%n*%f%t%?(%u)%?%{r})%{w}%?%+Lw%?%?%= %{g}][%{B} %d/%m %{W}%c %{g}]'
# hardstatus string "%{.kW}%-w%{.W}%n %t%{-}%{=b kw}%?%+w%?"            #B&W
# hardstatus string "%{.kW}%-w%{.W}%n %t%{-}%{=b kw}%?%+w%? %=%c %d/%m/%Y" #B&W & date&time
# hardstatus string "%{.kW}%-w%{.W}%n %t%{-}%{=b kw}%?%+w%? %=%c %d/%m/%Y" #B&W & date&time
# hardstatus string '%{= R}[%{w}%H%{R}][%{w}%=%?%-Lw%?%{R}%n*%f%t%?(%u)%? %{w}%?%+Lw%?%?%=%{R}][%{w}%m/%d %{W}%C%A%{R}]'
# hardstatus string "%{.kW}%-w%{.W}%n %t%{-}%+w %=%C %a "
#hardstatus string "%{=b kw} %?%-Lw%?%{=br kw}[%n %t]%{=b kw}%?%+Lw%? %="
#hardstatus alwayslastline '%{bk}[ %{W}%H %{b}][ %{w}%l%{b} ]   %{b}[%{w} %D %d.%m %c:%s%{b} ]'
#hardstatus alwayslastline '%{bk}[%{W}%H%{b}] %{w} %l %= %n*%t%{-b r}%{w}%+w %= %{w}%d %D %{w}%c'
#hardstatus alwayslastline '%{wk}[ %{g}][%= %{wk}%?%-Lw%?%{=b kR}(%{W}%n*%f %t%?(%u)%?%{=b kR})%{= kw}%?%+Lw%?%?%= %{g}][%{Y}%l%{g}]%{=b C}[ %m/%d %c ]%{W}'

sorendition 10 07
backtick     100 5 5 tail -1 /var/log/syslog
caption always '%{= wk} %= %100` %='


