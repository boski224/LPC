# ~/.bashrc_lpc_aliases

# ──────────────────────────────────────────
# Vim as default editor
# ──────────────────────────────────────────
export EDITOR=vim
export VISUAL=vim

# ──────────────────────────────────────────
# Vim mode in bash (readline)
# ──────────────────────────────────────────
set -o vi

# ──────────────────────────────────────────
# Colors set
# ──────────────────────────────────────────
# Colorki od Mateusza :D | HOST (future feature) | 
c_nc="\[\033[0m\]"        
c_white="\[\033[1;37m\]"  
c_black="\[\033[0;30m\]"  
c_blue="\[\033[0;34m\]"   
c_lblue="\[\033[1;34m\]"  
c_green="\[\033[0;32m\]"  
c_lgreen="\[\033[1;32m\]"     # LocalHost
c_cyan="\[\033[0;36m\]"       
c_lcyan="\[\033[1;36m\]"  
c_red="\[\033[0;31m\]"    
c_lred="\[\033[1;31m\]"   
c_purple="\[\033[0;35m\]"     # FE
c_lpurple="\[\033[1;35m\]"
c_yellow="\[\033[0;33m\]"     # Storage
c_lyellow="\[\033[1;33m\]"    # LSM
c_gray="\[\033[0;37m\]"   
c_lgray="\[\033[1;37m\]"  

# ──────────────────────────────────────────
# Aliases
# ──────────────────────────────────────────
alias ll='ls -lah'
alias la='ls -A'
alias l='ls -CF'
alias ..='cd ..'
alias ...='cd ../..'
alias h='history'
alias j='jobs'
alias v='vim'
alias grep='grep --color=auto'
alias df='df -h'
alias du='du -h'
alias free='free -h'
alias clr='clear'
alias py='python3'
alias ip='ip addr'
alias ping='ping -c 5'
alias top='htop'
alias reload='source ~/.bashrc'

# Git aliases:
alias gstat='git status' # gs is reserved by the system gst is a software, so using gstat for git status
alias gst="git status -vv"
alias gadd='git add'
alias gcm='git commit -m'
alias gdiff='git diff'
alias gfetch='git fetch' 
#alias gpush='git push' # Avoid conflict with system 'gp' command
alias gpull='git pull' # Avoid conflict with system 'gl' command
alias glog='git log --oneline -10'
alias gbranch='git branch'
alias gch='git checkout'
alias gsw='gsw'
alias gfp='echo "git fetch" && git fetch && echo "git pull" && git pull'
alias gmm='git merge main'

# Miscellaneous aliases:
alias fix-ssh='ssh_fix'
alias cls='clear'
alias update='sudo apt update && sudo apt upgrade -y'
alias mkdir='mkdir -p' # Create parent directories as needed
alias cp='cp -i' # Prompt before overwriting
alias mv='mv -i' # Prompt before overwriting
alias rm='rm -i' # Prompt before deleting

